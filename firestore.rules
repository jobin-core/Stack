rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for user documents and subcollections
    match /user/{userId} {
      // Allow read/write only if the authenticated user's UID or Email matches the document ID
      allow read, write: if request.auth != null && (
        request.auth.uid == userId || 
        (request.auth.token.email != null && request.auth.token.email == userId)
      );
      
      // Allow recursive subcollections under user document
      match /{document=**} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId || 
          (request.auth.token.email != null && request.auth.token.email == userId)
        );
      }
    }
  }
}
